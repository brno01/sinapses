{
  "name": "@brno01/sinapses",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Animated canvas strands that connect interface nodes and show each link state",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brno01/sinapses.git"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "default": "./src/react.ts"
    }
  },
  "files": [
    "src",
    "types"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:demo": "uv run --quiet --with playwright python -I tools/check_demo.py",
    "check:legacy": "python3 -I tools/check.py",
    "fixtures": "python3 -I tools/parity_fixtures.py",
    "types": "tsc -p tsconfig.types.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
